                        const server = http.createServer(async (req, res) => {
                        try {
                        const parsedUrl = new URL(req.url, 'http://' + (req.headers.host || 'localhost'));
                        const pathname = decodeURIComponent(parsedUrl.pathname);
                        const method = req.method;
                        const ip = getClientIp(req);

                        // ---------- trang tĩnh ----------
                        if (method === 'GET' && (pathname === '/website/admin/key' || pathname ===
                        '/website/admin/key/')) {
                        return sendHTML(res, 200, HTML_ADMIN_KEY);
                        }
                        if (method === 'GET' && pathname === '/assets/adminkey.js') return sendJS(res, 200,
                        JS_ADMIN_KEY);
                        if (method === 'GET' && (pathname === '/website/admin/code' || pathname ===
                        '/website/admin/code/')) {
                        return sendHTML(res, 200, HTML_ADMIN_CODE);
                        }
                        if (method === 'GET' && pathname === '/assets/admincode.js') return sendJS(res, 200,
                        JS_ADMIN_CODE);
                        if (method === 'GET' && pathname === '/favicon.ico') { res.writeHead(204); return res.end(); }
                        if (method === 'GET' && pathname === '/') {
                        return sendHTML(res, 200, '
                        <!DOCTYPE html>
                        <html>

                        <body
                          style="background:#0a0a0a;color:#fff;font-family:sans-serif;display:flex;align-items:center;justify-content:center;height:100vh;margin:0;gap:16px">
                          <a href="/website/admin/key/" style="color:#00f0ff">Trang tạo key →</a><a
                            href="/website/admin/code/" style="color:#00f0ff">Trang up code →</a>
                        </body>

                        </html>');
                        }

                        // ---------- API 1: check key ----------
                        // POST /api/v1/check-key-server/?chanbomaydi={uidapp} body: { key, device_id }
                        if (method === 'POST' && pathname === '/api/v1/check-key-server/') {
                        const uidapp = parsedUrl.searchParams.get('chanbomaydi') || '';
                        const body = await parseBody(req);
                        const key = (body.key || '').toString().trim();
                        const deviceId = (body.device_id || '').toString().trim();

                        const result = checkAccess(key, deviceId, uidapp, ip);
                        if (!result.key) return sendJSON(res, 200, { success: result.success, key: false, content:
                        result.content });

                        return sendJSON(res, 200, {
                        success: true,
                        key: true,
                        device_id: result.keyObj.device_id,
                        expiration_time: fmtExpiration(result.keyObj.expired_at),
                        });
                        }

                        // ---------- API 2: lấy code theo ID (CÒN MÃ HOÁ) ----------
                        // POST /api/v2/code-server/?id=... body: { key, device_id, uidapp }
                        if (method === 'POST' && pathname === '/api/v2/code-server/') {
                        const idParam = parsedUrl.searchParams.get('id');
                        const body = await parseBody(req);
                        const key = (body.key || '').toString().trim();
                        const deviceId = (body.device_id || '').toString().trim();
                        const uidapp = (body.uidapp || '').toString().trim();

                        const result = checkAccess(key, deviceId, uidapp, ip);
                        if (!result.key) return sendJSON(res, 200, { success: result.success, key: false, content:
                        result.content });

                        const fid = parseInt(idParam, 10);
                        if (!FILE_IDS.includes(fid)) {
                        return sendJSON(res, 200, { success: true, key: true, id: idParam, code: null, content: 'ID
                        không hợp lệ (chỉ 1-10).' });
                        }
                        const entry = codeCache.find((s) => s.fileId === fid);
                        if (!entry) {
                        return sendJSON(res, 200, { success: true, key: true, id: fid, code: null, content: 'Chưa có
                        code lưu cho ID này.' });
                        }
                        // trả nguyên bản mã hoá AES-256-GCM+Base64 — KHÔNG giải mã ở đây
                        return sendJSON(res, 200, { success: true, key: true, id: fid, code: entry.encryptedCode });
                        }

                        // ---------- ADMIN: login/logout ----------
                        if (method === 'POST' && pathname === '/api/admin/login') {
                        const attempt = loginAttempts.get(ip) || { fails: 0, lockUntil: 0 };
