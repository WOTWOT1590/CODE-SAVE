                          const target = decodeURIComponent(pathname.slice('/api/admin/keys/'.length));
                          const idx = keysCache.findIndex((k) => k.key === target);
                          if (idx === -1) return sendJSON(res, 404, { success: false, message: 'Không tìm thấy key' });
                          keysCache.splice(idx, 1);
