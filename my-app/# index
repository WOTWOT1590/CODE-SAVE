                          false, message: 'Thử lại sau ' + Math.ceil((attempt.lockUntil - Date.now()) / 1000) + 's' });
                          } const body=await parseBody(req); if (body.key===ADMIN_KEY) { loginAttempts.delete(ip); const
                          token=createAdminSession(); res.setHeader('Set-Cookie', 'session=' + token
                          + '; HttpOnly; Path=/; Max-Age=' + Math.floor(SESSION_TTL / 1000) + '; SameSite=Strict' );
                          return sendJSON(res, 200, { success: true }); } attempt.fails +=1; if (attempt.fails>=
                          MAX_LOGIN_FAILS) { attempt.lockUntil = Date.now() + LOGIN_LOCKOUT_MS; attempt.fails = 0; }
                          loginAttempts.set(ip, attempt);
                          return sendJSON(res, 401, { success: false, message: 'Sai admin key' });
                          }
                          if (method === 'POST' && pathname === '/api/admin/logout') {
