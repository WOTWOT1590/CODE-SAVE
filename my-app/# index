                          if (method === 'POST' && pathname === '/api/admin/keys') {
                          const body = await parseBody(req);
                          const newKey = makeKeyObject({ note: body.note, days: body.days });
                          keysCache.unshift(newKey);
                          saveArray(DATA_FILE, keysCache);
                          return sendJSON(res, 201, { success: true, key: Object.assign({}, newKey, { status:
                          getEffectiveStatus(newKey) }) });
                          }
                          if (method === 'POST' && pathname === '/api/admin/keys/bulk-delete') {
                          const body = await parseBody(req);
