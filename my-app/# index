                          if (idx === -1) return sendJSON(res, 404, { success: false, message: 'Chưa có code cho ID này'
                          });
                          codeCache.splice(idx, 1);
                          saveArray(CODE_FILE, codeCache);
                          return sendJSON(res, 200, { success: true });
