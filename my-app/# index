                        function init(){
                        fetch("/api/admin/server-code",{credentials:"same-origin"}).then(function(r){
                        if(r.status===401){ showLogin(); return null; }
                        return r.json();
                        }).then(function(res){
                        if(!res)return;
                        allSnippets=res.snippets||[];
                        renderIdList();
                        currentId=1;
                        showMain(); loadCurrent();
                        }).catch(function(){ showLogin(); });
                        }
                        init();
                        })();`;

                        // ============================================================
