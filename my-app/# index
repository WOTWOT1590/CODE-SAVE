                        fetch("/api/admin/login",{method:"POST",headers:{"Content-Type":"application/json"},credentials:"same-origin",body:JSON.stringify({key:key})})
                        .then(function(r){return r.json().then(function(d){return {ok:r.ok,data:d};});})
                        .then(function(res){
