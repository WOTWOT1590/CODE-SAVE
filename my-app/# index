                          }

                          // ---------- ADMIN: quản lý code theo ID ----------
                          if (pathname.indexOf('/api/admin/server-code') === 0) {
                          if (!isAdminAuthed(req)) return sendJSON(res, 401, { success: false, message: 'Chưa đăng nhập
                          hoặc phiên hết hạn' });

                          if (method === 'GET' && pathname === '/api/admin/server-code') {
                          const out = codeCache.map((s) => {
                          let code = ''; try { code = decryptCode(s.encryptedCode); } catch (e) { code = ''; }
