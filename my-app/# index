function loadArray(file) {
try { const d = JSON.parse(fs.readFileSync(file, 'utf-8')); return Array.isArray(d) ? d : []; }
catch (e) { return []; }
}
function saveArray(file, arr) { fs.writeFileSync(file, JSON.stringify(arr, null, 2), 'utf-8'); }
let keysCache = loadArray(DATA_FILE);
let codeCache = loadArray(CODE_FILE);
const adminSessions = new Map();
