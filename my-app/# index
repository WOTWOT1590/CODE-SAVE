// ============================================================
const KEY_CHARS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
function randGroup(len) {
let s = '';
for (let i = 0; i < len; i++) s +=KEY_CHARS[crypto.randomInt(0, KEY_CHARS.length)]; return s; } function
  generateKeyRaw() { return 'KEY-' + randGroup(3) + '-' + randGroup(4) + '-' + randGroup(5); } function
  generateUniqueKey() { let key, tries=0; do { key=generateKeyRaw(); tries++; } while (keysCache.some((k)=> k.key ===
  key) && tries < 50); return key; } function makeKeyObject({ note, days }) { const now=Date.now(); const
    d=parseInt(days, 10) || 0; return { key: generateUniqueKey(), note: (note || '' ).toString().slice(0, 200), revoked:
    false, device_id: null, created_at: now, activated_at: null, expired_at: d> 0 ? now + d * 86400000 : null,
    request_count: 0,
    auto_lock_until: null,
    };
    }
    function getEffectiveStatus(k) {
    if (k.revoked) return 'REVOKED';
    if (k.auto_lock_until && Date.now() < k.auto_lock_until) return 'LOCKED' ; if (k.expired_at && Date.now()>
      k.expired_at) return 'EXPIRED';
      if (k.device_id) return 'ACTIVE';
      return 'UNUSED';
      }
      function fmtExpiration(expiredAt) {
      if (!expiredAt) return 'Vĩnh viễn';
      const d = new Date(expiredAt);
      const p = (n) => (n < 10 ? '0' + n : '' + n); return p(d.getDate()) + '/' + p(d.getMonth() + 1) + '/' +
        d.getFullYear(); } //============================================================// MÃ HOÁ CODE LƯU: AES-256-GCM
        rồi Base64 //============================================================function encryptCode(plainText) { const
        iv=crypto.randomBytes(12); const cipher=crypto.createCipheriv('aes-256-gcm', CODE_AES_KEY, iv); const
        enc=Buffer.concat([cipher.update(String(plainText), 'utf8' ), cipher.final()]); const
        authTag=cipher.getAuthTag(); return Buffer.concat([iv, authTag, enc]).toString('base64'); } function
        decryptCode(base64Combined) { const combined=Buffer.from(base64Combined, 'base64' ); const
        iv=combined.subarray(0, 12); const authTag=combined.subarray(12, 28); const enc=combined.subarray(28); const
        decipher=crypto.createDecipheriv('aes-256-gcm', CODE_AES_KEY, iv); decipher.setAuthTag(authTag); return
        Buffer.concat([decipher.update(enc), decipher.final()]).toString('utf8'); } function upsertCodeEntry(fileId,
        code) { const now=Date.now(); const encryptedCode=encryptCode(code); let entry=codeCache.find((s)=> s.fileId ===
        fileId);
        if (entry) { entry.encryptedCode = encryptedCode; entry.updatedAt = now; }
        else { entry = { fileId, encryptedCode, createdAt: now, updatedAt: now }; codeCache.unshift(entry); }
        saveArray(CODE_FILE, codeCache);
        return entry;
        }

        // ============================================================
        // UID APP
        // ============================================================
        function verifyAppUid(uidapp) {
        if (!uidapp || uidapp.length !== OFFICIAL_APP_UID.length) return false;
        return crypto.timingSafeEqual(Buffer.from(uidapp), Buffer.from(OFFICIAL_APP_UID));
        }

        // ============================================================
        // LÕI KIỂM TRA key + device_id + uidapp — dùng chung API 1 và API 2
        // Trả về:
        // - { success:true, key:true, keyObj } khi cả 3 đều đúng
        // - { success:true, key:false, content:"..." } khi có vấn đề
        // ============================================================
        function recordIpAndCheckAbuse(keyObj, ip) {
        const now = Date.now();
        let list = recentIpsByKey.get(keyObj.key) || [];
        list = list.filter((e) => now - e.at < CONCURRENT_IP_WINDOW_MS); if (!list.some((e)=> e.ip === ip)) list.push({
          ip, at: now });
          recentIpsByKey.set(keyObj.key, list);
          const distinctIps = new Set(list.map((e) => e.ip));
          if (distinctIps.size >= 2) { keyObj.auto_lock_until = now + AUTO_LOCK_MS; return true; }
          return false;
          }
          function checkAccess(key, deviceId, uidapp, ip) {
          if (!key || !deviceId || !uidapp) {
          return { success: true, key: false, content: 'THỪA.!?' };
          }

          const uidOk = verifyAppUid(uidapp);
          const found = keysCache.find((k) => k.key === key);

          let keyProblem = null;
          if (!found) keyProblem = 'Key không tồn tại.';
          else if (found.revoked) keyProblem = 'Key đã bị khoá.';
          else if (found.expired_at && Date.now() > found.expired_at) keyProblem = 'Key đã hết hạn.';
          else if (found.auto_lock_until && Date.now() < found.auto_lock_until)
            keyProblem='Key tạm khoá do phát hiện dùng từ nhiều thiết bị/IP cùng lúc.' ; const keyOk=!keyProblem; //
            device_id chỉ đánh giá được khi key hợp lệ (có record để so sánh) let deviceProblem=null; if (keyOk &&
            found.device_id && found.device_id !==deviceId) { deviceProblem='Key đã kích hoạt trên thiết bị khác ' ; }
            const deviceOk=!deviceProblem; const wrongCount=(uidOk ? 0 : 1) + (keyOk ? 0 : 1) + (deviceOk ? 0 : 1); if
            (wrongCount>= 2) return { success: true, key: false, content: 'NGU À.' };
            if (wrongCount === 1) {
            if (keyProblem) return { success: true, key: false, content: keyProblem };
            if (deviceProblem) return { success: true, key: false, content: deviceProblem };
            return { success: true, key: false, content: 'APP ĐÃ BỊ TẬT.' };
            }

            // tất cả hợp lệ -> gắn thiết bị nếu lần đầu, tính request_count, check lạm dụng IP
            if (!found.device_id) { found.device_id = deviceId; found.activated_at = Date.now(); }
            const justLocked = recordIpAndCheckAbuse(found, ip);
            if (justLocked) {
            saveArray(DATA_FILE, keysCache);
            return { success: true, key: false, content: 'Key tạm khoá do phát hiện dùng từ nhiều IP cùng lúc.' };
            }
            found.request_count = (found.request_count || 0) + 1;
            saveArray(DATA_FILE, keysCache);
            return { success: true, key: true, keyObj: found };
            }

            // ============================================================
