                          }

                          // ---------- ADMIN: quản lý key ----------
                          if (pathname.indexOf('/api/admin/keys') === 0) {
                          if (!isAdminAuthed(req)) return sendJSON(res, 401, { success: false, message: 'Chưa đăng nhập
                          hoặc phiên hết hạn' });

                          if (method === 'GET' && pathname === '/api/admin/keys') {
                          const out = keysCache.map((k) => Object.assign({}, k, { status: getEffectiveStatus(k) }));
