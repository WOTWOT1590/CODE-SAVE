namespace AntiBanRuntime
{

    static std::atomic<bool> g_running{false};
    static std::mt19937 g_rng((uint32_t)time(nullptr));

    static void MonitorThermal()
    {
        FILE *f = fopen("/sys/class/thermal/thermal_zone0/temp", "r");
        if (!f)
            return;
        int t = 0;
        if (fscanf(f, "%d", &t) == 1)
        {
            if (t / 1000 > 45)
                std::this_thread::sleep_for(std::chrono::milliseconds(g_rng() % 1500 + 500));
        }
        fclose(f);
    }

    static void MonitorRAM()
    {
        FILE *f = fopen("/proc/meminfo", "r");
        if (!f)
            return;
        char line[256];
        while (fgets(line, sizeof(line), f))
        {
            if (strncmp(line, "MemAvailable:", 13) == 0)
            {
                long kb = atol(line + 13);
                if (kb < 200000)
                {
                    // trigger GC bằng cách yield
                    std::this_thread::yield();
                }
                break;
            }
        }
        fclose(f);
    }

    static void KillIfDebugged()
    {
        FILE *f = fopen("/proc/self/status", "r");
        if (!f)
            return;
        char line[256];
        while (fgets(line, sizeof(line), f))
        {
            if (strncmp(line, "TracerPid:", 10) == 0)
            {
                int pid = atoi(line + 10);
                if (pid != 0)
                    _exit(0);
            }
        }
        fclose(f);
    }

    static void AntiDebugLoop()
    {
        while (g_running)
        {
            if (ptrace(PTRACE_TRACEME, 0, nullptr, nullptr) == -1)
                _exit(0);
            std::this_thread::sleep_for(std::chrono::seconds(3));
        }
    }

    static void Loop()
    {
        while (g_running)
        {
            MonitorThermal();
            MonitorRAM();
            KillIfDebugged();
            std::this_thread::sleep_for(std::chrono::milliseconds(g_rng() % 80 + 20));
        }
    }

    static void Start()
    {
        g_running = true;
        std::thread(Loop).detach();
        std::thread(AntiDebugLoop).detach();
    }

    static void Stop() { g_running = false; }
}

