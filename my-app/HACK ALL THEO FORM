// --------------------------------------
// Quét memory tìm offset (thủ công)
// --------------------------------------
uintptr_t find_base()
{
    // Đọc /proc/self/maps để lấy base của libil2cpp.so hoặc libUnity.so
    FILE *fp = fopen("/proc/self/maps", "r");
    if (!fp)
        return 0;
    char line[512];
    uintptr_t base = 0;
    while (fgets(line, sizeof(line), fp))
    {
        if (strstr(line, "libil2cpp.so"))
        {
            sscanf(line, "%lx-", &base);
            break;
        }
    }
    fclose(fp);
    return base;
}

