    struct HookEntry
    {
        uintptr_t target;
        uint8_t original[12];
        bool active;
    };

    static std::unordered_map<uintptr_t, HookEntry> g_hooks;
    static std::vector<void *> g_stubs;
    static std::mutex g_hookMutex;

    static bool InstallHook(uintptr_t target, uintptr_t handler)
    {
        if (!target || !handler)
            return false;
        std::lock_guard<std::mutex> lock(g_hookMutex);

        HookEntry e{};
        e.target = target;
        e.active = true;
        if (!MemDroid::ReadMem(target, e.original, 12))
            return false;

        uint8_t patch[12];
        patch[0] = 0x48;
        patch[1] = 0xB8;
        memcpy(patch + 2, &handler, 8);
        patch[10] = 0xFF;
        patch[11] = 0xE0;

        uintptr_t page = target & ~0xFFF;
        mprotect((void *)page, 0x1000, PROT_READ | PROT_WRITE | PROT_EXEC);
        MemDroid::WriteMem(target, patch, 12);
        mprotect((void *)page, 0x1000, PROT_READ | PROT_EXEC);

        g_hooks[target] = e;
        return true;
    }

    static void RemoveHook(uintptr_t target)
    {
        std::lock_guard<std::mutex> lock(g_hookMutex);
        auto it = g_hooks.find(target);
        if (it == g_hooks.end())
            return;
        uintptr_t page = target & ~0xFFF;
        mprotect((void *)page, 0x1000, PROT_READ | PROT_WRITE | PROT_EXEC);
        MemDroid::WriteMem(target, it->second.original, 12);
        mprotect((void *)page, 0x1000, PROT_READ | PROT_EXEC);
        g_hooks.erase(it);
    }

    static uintptr_t AllocStub(const uint8_t *code, size_t len)
    {
        void *mem = mmap(nullptr, 0x1000, PROT_READ | PROT_WRITE | PROT_EXEC,
                         MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
        if (mem == MAP_FAILED)
            return 0;
        memcpy(mem, code, len);
        g_stubs.push_back(mem);
        return (uintptr_t)mem;
    }

    static uintptr_t StubFalse()
    {
        const uint8_t code[] = {0x31, 0xC0, 0xC3}; // xor eax, eax; ret
        return AllocStub(code, sizeof(code));
    }

    static uintptr_t StubNegOne()
    {
        const uint8_t code[] = {0xB8, 0xFF, 0xFF, 0xFF, 0xFF, 0xC3}; // mov eax,-1; ret
        return AllocStub(code, sizeof(code));
    }

    static uintptr_t StubZero()
    {
        const uint8_t code[] = {0x31, 0xC0, 0xC3};
        return AllocStub(code, sizeof(code));
    }

    static uintptr_t FindExport(uintptr_t base, const std::string &name)
    {
        if (!base)
            return 0;
        ElfW(Ehdr) eh;
        if (!MemDroid::ReadMem(base, &eh, sizeof(eh)))
            return 0;
        if (memcmp(eh.e_ident, ELFMAG, 4) != 0)
            return 0;

        std::vector<ElfW(Shdr)> sh(eh.e_shnum);
        if (!MemDroid::ReadMem(base + eh.e_shoff, sh.data(), sh.size() * sizeof(ElfW(Shdr))))
            return 0;

        for (auto &s : sh)
        {
            if (s.sh_type != SHT_DYNSYM)
                continue;
            std::vector<ElfW(Sym)> syms(s.sh_size / sizeof(ElfW(Sym)));
            if (!MemDroid::ReadMem(base + s.sh_offset, syms.data(), s.sh_size))
                continue;
            std::vector<char> strtab(s.sh_size);
            if (s.sh_link < sh.size())
            {
                auto &strsec = sh[s.sh_link];
                strtab.resize(strsec.sh_size);
                MemDroid::ReadMem(base + strsec.sh_offset, strtab.data(), strsec.sh_size);
            }
            for (auto &sym : syms)
            {
                if (sym.st_name == 0 || sym.st_value == 0)
                    continue;
                if (sym.st_name < strtab.size())
                {
                    if (strcmp(&strtab[sym.st_name], name.c_str()) == 0)
                        return base + sym.st_value;
                }
            }
        }
        return 0;
    }

    static void HookCommonChecks()
    {
        const char *funcs[] = {
            "anogs_check", "anogs_verify", "anogs_scan", "anogs_report",
            "anogs_init", "anogs_run", "anogs_thread"};
        uintptr_t stub = StubFalse();
        for (auto f : funcs)
        {
            uintptr_t addr = FindExport(MemDroid::g_anogs, f);
            if (addr)
                InstallHook(addr, stub);
        }
    }

    static void Start()
    {
        HookCommonChecks();
    }
}

