    static std::mt19937 g_rng((uint32_t)time(nullptr));
    static std::vector<uintptr_t> g_nopRegions;
    static void SafePatch(uintptr_t addr, const uint8_t *patch, size_t len)
    {
        uintptr_t page = addr & ~0xFFF;
        size_t plen = (addr + len - page + 0xFFF) & ~0xFFF;
        mprotect((void *)page, plen, PROT_READ | PROT_WRITE | PROT_EXEC);
        std::this_thread::sleep_for(std::chrono::milliseconds(g_rng() % 50 + 15));
        MemDroid::WriteMem(addr, patch, len);
        std::this_thread::sleep_for(std::chrono::milliseconds(g_rng() % 30 + 5));
        mprotect((void *)page, plen, PROT_READ | PROT_EXEC);
    }
    static void NopRegion(uintptr_t addr, size_t len)
    {
        std::vector<uint8_t> nop(len, 0x90);
        SafePatch(addr, nop.data(), len);
        g_nopRegions.push_back(addr);
    }
    static void ScanAndPatch(uintptr_t base, size_t size,
                             const uint8_t *sig, size_t sigLen,
                             const uint8_t *patch, size_t patchLen)
    {
        if (!base)
            return;
        std::vector<uint8_t> region(size);
        if (!MemDroid::ReadMem(base, region.data(), size))
            return;
        for (size_t i = 0; i + sigLen < region.size(); i++)
        {
            bool match = true;
            for (size_t j = 0; j < sigLen; j++)
            {
                if (sig[j] != 0x00 && region[i + j] != sig[j])
                {
                    match = false;
                    break;
                }
            }
            if (match)
            {
                SafePatch(base + i, patch, patchLen);
                break;
            }
        }
    }

    static void PatchAnogs()
    {
        if (!MemDroid::g_anogs)
            return;
        // E8 ?? ?? ?? ?? 55 48 89 E5 — call check
        const uint8_t sig[] = {0xE8, 0x00, 0x00, 0x00, 0x00, 0x55, 0x48, 0x89, 0xE5};
        const uint8_t ret[] = {0xC3};
        ScanAndPatch(MemDroid::g_anogs, 0x800000, sig, sizeof(sig), ret, sizeof(ret));
    }

    static void PatchTersafe()
    {
        if (!MemDroid::g_tersafe)
            return;
        const uint8_t sig[] = {0x55, 0x48, 0x89, 0xE5, 0x41, 0x57};
        const uint8_t ret[] = {0xC3};
        ScanAndPatch(MemDroid::g_tersafe, 0x600000, sig, sizeof(sig), ret, sizeof(ret));
    }

    static void HideModuleNames()
    {
        const char *targets[] = {"libanogs.so", "libtersafe.so", "libtgkill.so"};
        for (auto t : targets)
        {
            uintptr_t b = MemDroid::FindModule(t);
            if (!b)
                continue;
            const char fake[] = "libaudio.so\0\0\0\0\0\0\0\0";
            mprotect((void *)(b & ~0xFFF), 0x1000, PROT_READ | PROT_WRITE);
            MemDroid::WriteMem(b, fake, sizeof(fake));
            mprotect((void *)(b & ~0xFFF), 0x1000, PROT_READ | PROT_EXEC);
        }
    }

    static void SpoofLibCRC()
    {
        uintptr_t b = MemDroid::g_il2cpp;
        if (!b)
            return;
        uint8_t zero[4] = {0, 0, 0, 0};
        mprotect((void *)((b + 0x200) & ~0xFFF), 0x1000, PROT_READ | PROT_WRITE);
        MemDroid::WriteMem(b + 0x200, zero, 4);
        mprotect((void *)((b + 0x200) & ~0xFFF), 0x1000, PROT_READ | PROT_EXEC);
    }

    static void Start()
    {
        PatchAnogs();
        PatchTersafe();
        HideModuleNames();
        SpoofLibCRC();
    }
}

namespace AntiBanHook
