// --------------------------------------
// Hook bằng inline assembly (ARM64)
// --------------------------------------
void inline_hook(uintptr_t target, uintptr_t replacement)
{
    // Mở quyền ghi cho trang nhớ
    long page_size = sysconf(_SC_PAGESIZE);
    uintptr_t page_start = (target & ~(page_size - 1));
    mprotect((void *)page_start, page_size, PROT_READ | PROT_WRITE | PROT_EXEC);

    // Ghi lệnh nhảy (branch) - ARM64: LDR X16, =addr ; BR X16
    uint32_t instr[4];
    instr[0] = 0x58000050; // LDR X16, [PC, #0x10]
    instr[1] = 0xD61F0200; // BR X16
    instr[2] = (uint32_t)(replacement & 0xFFFFFFFF);
    instr[3] = (uint32_t)((replacement >> 32) & 0xFFFFFFFF);

    memcpy((void *)target, instr, 16);
    __builtin___clear_cache((void *)target, (void *)(target + 16));
    mprotect((void *)page_start, page_size, PROT_READ | PROT_EXEC);
}

