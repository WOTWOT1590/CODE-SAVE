static int FindFFPid()
{
    DIR *d = opendir("/proc");
    if (!d)
        return 0;
    struct dirent *e;
    while ((e = readdir(d)))
    {
        if (e->d_type != DT_DIR)
            continue;
        int pid = atoi(e->d_name);
        if (pid <= 0)
            continue;
        char path[64];
        snprintf(path, sizeof(path), "/proc/%d/cmdline", pid);
        FILE *f = fopen(path, "r");
        if (!f)
            continue;
        char cmd[256] = {0};
        fread(cmd, 1, sizeof(cmd) - 1, f);
        fclose(f);
        if (strstr(cmd, "com.dts.freefireth") || strstr(cmd, "com.dts.freefiremax"))
        {
            closedir(d);
            return pid;
        }
    }
    closedir(d);
    return 0;
}

__attribute__((constructor)) static void AutoStart()
{
    // chờ FF load xong
    for (int i = 0; i < 60; i++)
    {
        int pid = FindFFPid();
        if (pid > 0)
        {
            AntiBanCoordinator::StartAll(pid);
            break;
        }
        std::this_thread::sleep_for(std::chrono::seconds(2));
    }
}

__attribute__((destructor)) static void AutoStop()
{
    AntiBanCoordinator::StopAll();
}

