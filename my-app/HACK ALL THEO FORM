    static int g_pid = 0;
    static uintptr_t g_il2cpp = 0;
    static uintptr_t g_anogs = 0;
    static uintptr_t g_tersafe = 0;
    static uintptr_t g_unity = 0;

    static std::unordered_map<std::string, uintptr_t> g_mapCache;
    static std::mutex g_mapMutex;

    static uintptr_t FindModule(const std::string &name)
    {
        std::lock_guard<std::mutex> lock(g_mapMutex);
        auto it = g_mapCache.find(name);
        if (it != g_mapCache.end())
            return it->second;

        uintptr_t base = 0;
        FILE *f = fopen("/proc/self/maps", "r");
        if (!f)
            return 0;

        char line[512];
        while (fgets(line, sizeof(line), f))
        {
            if (strstr(line, name.c_str()) && strstr(line, "r-xp"))
            {
                base = strtoull(line, nullptr, 16);
                break;
            }
        }
        fclose(f);
        g_mapCache[name] = base;
        return base;
    }

    static void InitModules()
    {
        g_il2cpp = FindModule("libil2cpp.so");
        g_anogs = FindModule("libanogs.so");
        g_tersafe = FindModule("libtersafe.so");
        g_unity = FindModule("libunity.so");
    }

    static bool ReadMem(uintptr_t addr, void *buf, size_t size)
    {
        struct iovec local = {buf, size};
        struct iovec remote = {(void *)addr, size};
        ssize_t n = syscall(SYS_process_vm_readv, g_pid, &local, 1, &remote, 1, 0);
        return n == (ssize_t)size;
    }

    static bool WriteMem(uintptr_t addr, const void *buf, size_t size)
    {
        struct iovec local = {(void *)buf, size};
        struct iovec remote = {(void *)addr, size};
        ssize_t n = syscall(SYS_process_vm_writev, g_pid, &local, 1, &remote, 1, 0);
        return n == (ssize_t)size;
    }

    template <typename T>
    static T Read(uintptr_t addr)
    {
        T v{};
        ReadMem(addr, &v, sizeof(T));
        return v;
    }

    template <typename T>
    static void Write(uintptr_t addr, T val)
    {
        WriteMem(addr, &val, sizeof(T));
    }

    static uintptr_t Chain(uintptr_t base, std::initializer_list<uint32_t> offs)
    {
        uintptr_t cur = base;
        for (uint32_t o : offs)
            cur = Read<uintptr_t>(cur + o);
        return cur;
    }
}

